[
 {
  "id": "docs.dead_paths",
  "params": {
   "lint": {
    "interpreter": "python3",
    "script": "tools/voice_lint.py",
    "args": [
     "--rules",
     "tools/voice_rules.json"
    ],
    "scope": "every doc of the doc set"
   },
   "doc_set_left_out": [
    {
     "glob": ".github/PULL_REQUEST_TEMPLATE.md",
     "why": "a form GitHub copies into each pull request, not a doc read in the repo"
    }
   ],
   "areas": [
    {
     "doc": "docs/PLAN.md",
     "area": []
    },
    {
     "doc": "**",
     "area": [
      "{dir}/"
     ]
    }
   ]
  }
 }
]
